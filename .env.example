# Server
PORT=3000

# MongoDB
MONGO_URI=

# JWT
JWT_SECRET=

# Cloudinary (for profile picture uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Admin SDK (for push notifications)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\\n-----END PRIVATE KEY-----\n

# Brevo (for email verification) — free at https://app.brevo.com
# No custom domain needed — just verify your Gmail in Brevo dashboard
# Steps: SMTP & API → API Keys → Generate key
#        Senders & IP → Senders → Add your email → verify it
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=

# Your deployed backend URL (used in verification email links)
APP_URL=https://your-app.up.railway.app

# CORS
CORS_ORIGIN=*
